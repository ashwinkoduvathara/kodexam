# ─── Server-only (never exposed to the browser) ─────────────────────────────
# MongoDB connection string and database name. Must be a replica set (transactions);
# for local development run `npm run db:replset` and use
# mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
MONGODB_URI=
MONGODB_DB_NAME=kodeproctor

# Secret that signs KProctor SESSION cookies (min. 32 random characters). Never shared with the LMS.
KPROCTOR_AUTH_SECRET=

# ─── LMS launch (production sign-in) ─────────────────────────────────────────
# Ed25519 PUBLIC key of the LMS (SPKI base64 or PEM); create with `npm run lms:keygen`.
# The private key stays with the LMS. Empty = LMS launch disabled.
KPROCTOR_LMS_LAUNCH_PUBLIC_KEY=
# Expected `iss` of launch tokens (e.g. https://kodeversity.com).
KPROCTOR_LMS_ISSUER=
KPROCTOR_LAUNCH_MAX_LIFETIME_SECONDS=120
KPROCTOR_LAUNCH_CLOCK_SKEW_SECONDS=30
KPROCTOR_SESSION_TTL_MINUTES=480
# NEVER in production: lets a production build accept dev launch links (local preview only).
KPROCTOR_ALLOW_DEV_LAUNCH=

# ─── Expiry worker & monitoring ─────────────────────────────────────────────
KPROCTOR_EXPIRY_INTERVAL_SECONDS=15
KPROCTOR_EXPIRY_BATCH_SIZE=200
KPROCTOR_EXPIRY_LEASE_SECONDS=60
KPROCTOR_EXPIRY_ALERT_SECONDS=120
# Enables GET /api/ops/health (Bearer token, min. 32 characters). Empty = endpoint off.
KPROCTOR_OPS_TOKEN=
# 32-byte base64 key for encrypted backups (npm run drill:backup generates a throwaway key if empty).
KPROCTOR_BACKUP_KEY=

# Public base URL of this app (used by scripts to print launch links).
KPROCTOR_APP_URL=http://localhost:3100

# Only when running behind a trusted reverse proxy (enables X-Forwarded-For/Proto).
KPROCTOR_TRUST_PROXY=false

# ─── Identity verification (server-only) ────────────────────────────────────
# Storage: "s3" in production (private bucket, SSE-KMS). "local" = development only.
KPROCTOR_IDENTITY_STORAGE=local
KPROCTOR_IDENTITY_LOCAL_DIR=.data/identity-objects
# Development only: 32-byte base64 key for local envelope encryption. Never commit it.
KPROCTOR_IDENTITY_MASTER_KEY=
KPROCTOR_S3_BUCKET=
KPROCTOR_S3_REGION=
KPROCTOR_S3_ENDPOINT=
KPROCTOR_S3_KMS_KEY_ID=
KPROCTOR_S3_FORCE_PATH_STYLE=false
# Malware scanning: "clamav" (required in production) or "none" (documents stay SCAN_PENDING).
KPROCTOR_MALWARE_SCANNER=none
KPROCTOR_CLAMAV_HOST=127.0.0.1
KPROCTOR_CLAMAV_PORT=3310
# Limits and retention
KPROCTOR_IDENTITY_MAX_DOCUMENT_MB=5
KPROCTOR_IDENTITY_MAX_PHOTO_MB=2
KPROCTOR_IDENTITY_SIGNED_URL_TTL_SECONDS=60
KPROCTOR_IDENTITY_DOCUMENT_RETENTION_DAYS=30
KPROCTOR_IDENTITY_PHOTO_RETENTION_DAYS=30
# Empty = keep audit logs indefinitely; a number creates a TTL index.
KPROCTOR_AUDIT_RETENTION_DAYS=
KPROCTOR_IDENTITY_MAX_RETRIES=2
KPROCTOR_IDENTITY_RATE_WINDOW_SECONDS=600
KPROCTOR_IDENTITY_CAPTURE_LIMIT=10
KPROCTOR_IDENTITY_UPLOAD_LIMIT=10
KPROCTOR_IDENTITY_VERIFY_LIMIT=6
KPROCTOR_IDENTITY_RETRY_LIMIT=3

# ─── Client (VITE_* values are bundled into the browser build) ───────────────
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_SUPPORT_HOURS=
# Where candidates return after leaving an exam (e.g. the LMS dashboard).
VITE_LMS_URL=
# Optional: base URL of a dedicated network-test service.
VITE_NETWORK_TEST_BASE_URL=
